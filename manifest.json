{
  "manifest_version": 3,
  "name": "At Peace",
  "version": "0.3.0",
  "description": "A calm, intentional YouTube. Hide what you don't want to see and add a breath before you open the feed.",
  "browser_specific_settings": {
    "gecko": {
      "id": "at-peace@cristianbagrin",
      "update_url": "https://raw.githubusercontent.com/cristianbagrin/at-peace-updates/main/updates.json",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "alarms", "declarativeNetRequest", "scripting"],
  "host_permissions": ["*://*.youtube.com/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "scripts": [
      "src/shared/namespace.js",
      "src/shared/browser-api.js",
      "src/shared/util.js",
      "src/shared/messages.js",
      "src/shared/schema-core.js",
      "src/shared/schema/general.js",
      "src/shared/schema/pause.js",
      "src/shared/schema/focus.js",
      "src/shared/schema/advanced.js",
      "src/sites/youtube/schema/general.js",
      "src/sites/youtube/schema/masthead.js",
      "src/sites/youtube/schema/guide.js",
      "src/sites/youtube/schema/home.js",
      "src/sites/youtube/schema/watch.js",
      "src/sites/youtube/schema/player.js",
      "src/sites/youtube/schema/comments.js",
      "src/sites/youtube/schema/search.js",
      "src/sites/youtube/schema/shorts.js",
      "src/sites/youtube/schema/subscriptions.js",
      "src/sites/youtube/schema/channel.js",
      "src/shared/presets.js",
      "src/shared/settings.js",
      "src/shared/state.js",
      "src/shared/lock.js",
      "src/sites/youtube/redirects.js",
      "src/background/store.js",
      "src/background/stats.js",
      "src/background/sessions.js",
      "src/background/rules.js",
      "src/background/guards.js",
      "src/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": [
        "src/shared/namespace.js",
        "src/shared/browser-api.js",
        "src/shared/util.js",
        "src/shared/messages.js",
        "src/shared/schema-core.js",
        "src/shared/schema/general.js",
        "src/shared/schema/pause.js",
        "src/shared/schema/focus.js",
        "src/shared/schema/advanced.js",
        "src/sites/youtube/schema/general.js",
        "src/sites/youtube/schema/masthead.js",
        "src/sites/youtube/schema/guide.js",
        "src/sites/youtube/schema/home.js",
        "src/sites/youtube/schema/watch.js",
        "src/sites/youtube/schema/player.js",
        "src/sites/youtube/schema/comments.js",
        "src/sites/youtube/schema/search.js",
        "src/sites/youtube/schema/shorts.js",
        "src/sites/youtube/schema/subscriptions.js",
        "src/sites/youtube/schema/channel.js",
        "src/shared/presets.js",
        "src/shared/settings.js",
        "src/shared/state.js",
        "src/content/engine.js",
        "src/sites/youtube/page.js",
        "src/sites/youtube/bridge-client.js",
        "src/sites/youtube/redirects.js",
        "src/sites/youtube/features/_shared.js",
        "src/sites/youtube/features/bridge-tags.js",
        "src/sites/youtube/features/home-feed.js",
        "src/sites/youtube/features/shorts.js",
        "src/sites/youtube/features/autoplay.js",
        "src/sites/youtube/features/theater.js",
        "src/sites/youtube/features/speed.js",
        "src/sites/youtube/features/still-watching.js",
        "src/sites/youtube/features/channel-tab.js",
        "src/sites/youtube/features/thumbnails-hover.js",
        "src/sites/youtube/features/thumbnail-frame.js",
        "src/sites/youtube/features/search-suggestions.js",
        "src/sites/youtube/features/layout-nudge.js",
        "src/shared/breath.js",
        "src/content/overlay.js",
        "src/content/guard-core.js",
        "src/sites/youtube/features/session-guard.js",
        "src/sites/youtube/features/time-tracker.js",
        "src/content/picker.js",
        "src/sites/youtube/main.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/sites/youtube/page-bridge.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "At Peace",
    "default_popup": "src/pages/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/pages/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/pages/pause/*",
        "src/pages/blocked/*",
        "src/pages/common/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Turn At Peace on or off"
    },
    "focus-25": {
      "suggested_key": { "default": "Alt+Shift+F", "mac": "Alt+Shift+F" },
      "description": "Block YouTube for 25 minutes"
    },
    "open-picker": {
      "suggested_key": { "default": "Alt+Shift+H", "mac": "Alt+Shift+H" },
      "description": "Pick an element to hide"
    }
  }
}
