{
  "name": "at-peace",
  "version": "0.1.0",
  "description": "A calm, intentional YouTube: hide what you don't want to see and add a little friction between you and the feed.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Cristian Bagrin",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && web-ext lint --self-hosted",
    "test": "node --test tests/unit/",
    "e2e": "node --test --test-concurrency=1 tests/e2e/",
    "test:firefox": "bash tests/firefox/setup.sh && node tests/firefox/smoke.mjs",
    "selectors": "node tools/check-selectors.mjs",
    "start:firefox": "web-ext run",
    "build": "web-ext build",
    "sign": "web-ext sign --channel=unlisted",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "selenium-webdriver": "^4.50.0",
    "web-ext": "^10.7.0"
  }
}
